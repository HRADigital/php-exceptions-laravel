#!/usr/bin/env bash
#
# Conventional Commits gate, run locally before the commit is written.
#
# The package's version is derived entirely from commit messages (see
# .github/workflows/release.yml), so a malformed message silently costs a release. CI
# catches it too, but by then the message is already in the history and rewriting it
# means a force-push - which is exactly what this hook exists to avoid.
#
# Install with:  git config core.hooksPath .githooks
# Bypass once:   git commit --no-verify
#
# Rules live in commitlint.config.mjs, the same file CI reads. When commitlint is not
# installed locally the hook falls back to a plain header check rather than blocking the
# commit outright - a developer without npx still gets the shape enforced.

set -euo pipefail

MESSAGE_FILE="$1"

# Merge, revert, fixup and squash messages are generated by git itself and are exempt.
FIRST_LINE="$(head -n1 "${MESSAGE_FILE}")"
case "${FIRST_LINE}" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

if command -v npx >/dev/null 2>&1 && npx --no-install commitlint --version >/dev/null 2>&1; then
    exec npx --no-install commitlint --edit "${MESSAGE_FILE}"
fi

# Fallback: the same shape commitlint's config-conventional enforces, minus the type
# allow-list, which only the real tool can keep in sync with the config file.
PATTERN='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9_./-]+\))?!?: .+'

if ! printf '%s' "${FIRST_LINE}" | grep -Eq "${PATTERN}"; then
    echo "commit-msg: the message header does not follow Conventional Commits." >&2
    echo >&2
    echo "  got:      ${FIRST_LINE}" >&2
    echo "  expected: <type>(<optional scope>): <description>" >&2
    echo "  types:    build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test" >&2
    echo >&2
    echo "A breaking change needs a footer on its own line, after a blank line:" >&2
    echo "  BREAKING CHANGE: <what broke + what callers must do>" >&2
    exit 1
fi

if [ "${#FIRST_LINE}" -gt 120 ]; then
    echo "commit-msg: the header is ${#FIRST_LINE} characters; the limit is 120." >&2
    exit 1
fi

exit 0
