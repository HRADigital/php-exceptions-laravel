{
    "name": "hradigital/php-exceptions-laravel",
    "description": "Laravel wrapper for hradigital/php-exceptions, wiring Laravel's error handling and providing a JSON Renderer for these Exceptions.",
    "type": "library",
    "license": "MPL-2.0",
    "keywords": [
        "hradigital",
        "laravel",
        "exceptions",
        "renderer",
        "json"
    ],
    "authors": [
        {
            "name": "Hugo Azevedo",
            "email": "github@hradigital.com"
        }
    ],
    "homepage": "https://github.com/HRADigital/php-exceptions-laravel",
    "support": {
        "issues": "https://github.com/HRADigital/php-exceptions-laravel/issues",
        "source": "https://github.com/HRADigital/php-exceptions-laravel"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/HRADigital/php-static-analysis.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "hradigital/php-exceptions": "^1.0",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "symfony/http-foundation": "^7.0"
    },
    "require-dev": {
        "hradigital/php-static-analysis": "^1.0",
        "orchestra/testbench": "^10.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "HraDigital\\Components\\ExceptionRenderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HraDigital\\Components\\ExceptionRenderer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HraDigital\\Components\\ExceptionRenderer\\ExceptionsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "phpcbf --standard=phpcs.xml.dist",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --no-coverage",
        "ci": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
